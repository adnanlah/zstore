{
  "name": "zstore",
  "version": "0.1.0",
  "description": "JSON store",
  "author": "Adnan Lahrech",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup src/*.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit --composite false",
    "format": "prettier --write .",
    "test": "mocha"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "chai": "^6.2.1",
    "chalk": "^5.6.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "zod": ">=4.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "tsup": {
    "dts": true,
    "bundle": false,
    "treeshake": true,
    "target": "node18",
    "format": [
      "esm",
      "cjs"
    ],
    "entry": [
      "src/**/*.ts"
    ],
    "external": [
      "zod"
    ]
  },
  "mocha": {
    "useTsNode": true
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
