{
  "name": "zstore",
  "version": "0.1.0",
  "description": "JSON store",
  "author": "Adnan Lahrech",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup src/*.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit --composite false",
    "format": "prettier --write .",
    "test": "mocha"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/chai": "^4.3.17",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.4.0",
    "chai": "^5.1.1",
    "chalk": "^5.3.0",
    "mocha": "^10.7.3",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "tsx": "^4.17.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "zod": "^4.0.14"
  },
  "peerDependencies": {
    "zod": ">=4.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "tsup": {
    "dts": true,
    "bundle": false,
    "treeshake": true,
    "target": "node18",
    "format": [
      "esm",
      "cjs"
    ],
    "entry": [
      "src/**/*.ts"
    ],
    "external": [
      "zod"
    ]
  },
  "mocha": {
    "useTsNode": true
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
